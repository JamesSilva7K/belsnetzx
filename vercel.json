{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/janaadmin1978/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/janaadmin1978",
      "destination": "/admin.html"
    },
    {
      "source": "/janaadmin1978/(.*)",
      "destination": "/admin.html"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}

