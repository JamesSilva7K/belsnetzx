# ─────────────────────────────────────────────────────────────
#  Aura Rosa — modelo de configuração (copie para .env.local)
# ─────────────────────────────────────────────────────────────

# Portas: loja e painel administrativo em servidores separados.
STORE_PORT=3000
ADMIN_PORT=3100
HOST=127.0.0.1

PUBLIC_URL=https://sualoja.com.br
ADMIN_PUBLIC_URL=https://admin.sualoja.com.br

# Credencial inicial do administrador.
# Se ADMIN_PASSWORD ficar vazio, o servidor gera uma senha aleatória
# e a exibe UMA única vez no console.
ADMIN_USER=JanaLopez
ADMIN_PASSWORD=1978JanaLopez

ADMIN_SESSION_HOURS=8
ADMIN_MAX_ATTEMPTS=5
ADMIN_LOCK_MINUTES=15

# Regras de negócio
FREE_SHIPPING_THRESHOLD=299
SHIPPING_PAC=19.90
SHIPPING_SEDEX=34.90
LOW_STOCK_THRESHOLD=3
CART_ABANDON_MINUTES=30

# ── Bot do Telegram ──────────────────────────────────────────
# 1. Fale com @BotFather, crie um bot e copie o token.
# 2. Envie /start para o seu bot.
# 3. Rode o sistema e cole o token na aba "Bot Telegram" do painel
#    (ele descobre o chat automaticamente pelo getUpdates).
# 4. Alternativa rápida: preencha as variáveis abaixo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Vários administradores: separe por vírgula.
TELEGRAM_ADMIN_IDS=
TELEGRAM_POLLING=true
# Use webhook quando estiver atrás de um domínio com HTTPS:
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# ── Opcionais ────────────────────────────────────────────────
# Sobrescreve as chaves mestras geradas em server/data/keys.json.
# MASTER_KEY=
# ADMIN_PATH_SECRET=
# ── Gateway SyncPay (Produção) ───────────────────────────────
SYNCPAY_CLIENT_ID=2dffd631-f327-4fd8-aa6c-cf0bbe28a97e
SYNCPAY_CLIENT_SECRET=cde163b7-0107-45b8-8721-68f817c2ceba
SYNCPAY_API_BASE=https://api.syncpayments.com.br/api/partner/v1
